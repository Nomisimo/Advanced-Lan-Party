{
  "name": "advanced-lan",
  "version": "0.1.0-beta.4",
  "private": true,
  "description": "Advanced LAN: Game-PCs melden Spielereignisse, die Regie sendet OSC-Befehle an Licht, Audio und Video",
  "author": "Momo",
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "overwolf": {
    "packages": []
  },
  "scripts": {
    "build": "node scripts/build.js --minify",
    "build:dev": "node scripts/build.js",
    "start": "npm run build:dev && ow-electron .",
    "test": "node --test --test-timeout=30000 test/*.test.js",
    "pack": "npm run build && ow-electron-builder --dir",
    "dist": "npm run build && ow-electron-builder",
    "dist:win": "npm run build && ow-electron-builder --win",
    "dist:mac": "npm run build && ow-electron-builder --mac --x64"
  },
  "build": {
    "appId": "dev.advancedlan",
    "productName": "Advanced LAN",
    "icon": "assets/app-icon/icon.png",
    "files": [
      "src/main/**",
      "src/core/**",
      "src/preload/**",
      "dist-app/index.html",
      "assets/app-icon/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Nomisimo",
      "repo": "Advanced-Lan-Party"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Advanced LAN findet Sessions im lokalen Netz (mDNS), verbindet Game-PCs mit der Regie und sendet OSC-Befehle an Licht, Audio und Video.",
        "NSBonjourServices": [
          "_advancedlan._tcp"
        ]
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^42.11.4",
    "@overwolf/ow-electron-builder": "^26.9.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.9",
    "ws": "^8.22.0"
  }
}
